# Flask Dashboard Configuration
FLASK_SECRET_KEY=generate_a_random_32_character_string_here
FLASK_ENV=development
DASHBOARD_PORT=5000
DASHBOARD_HOST=0.0.0.0

# Discord OAuth2
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_CLIENT_SECRET=your_application_client_secret
OAUTH2_REDIRECT_URI=http://localhost:5000/auth/callback

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Bot API
BOT_API_URL=http://localhost:3001
DASHBOARD_SHARED_SECRET=generate_a_random_64_character_string_here

# Admin Role IDs (comma-separated, must match bot config)
ADMIN_ROLE_IDS=role_id_1,role_id_2