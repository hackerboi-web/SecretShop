# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_CLIENT_SECRET=your_application_client_secret
DISCORD_GUILD_ID=your_server_guild_id

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Bot REST API Configuration
BOT_API_PORT=3001
BOT_API_HOST=0.0.0.0

# JWT Configuration (generate with: openssl genrsa -out keys/private.pem 2048 && openssl rsa -in keys/private.pem -pubout -out keys/public.pem)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ISSUER=secret-shop-bot
JWT_AUDIENCE=secret-shop-dashboard

# Dashboard Shared Secret (for initial token exchange)
DASHBOARD_SHARED_SECRET=generate_a_random_64_character_string_here

# Dashboard URL (for CORS and redirects)
DASHBOARD_URL=http://localhost:5000

# Panel Channel (where bot posts persistent panels)
PANEL_CHANNEL_ID=your_panel_channel_id

# Admin Role IDs (comma-separated)
ADMIN_ROLE_IDS=role_id_1,role_id_2

# Bot Configuration
NODE_ENV=development
LOG_LEVEL=info