{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shop Items Configuration",
  "type": "object",
  "properties": {
    "items": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9_]+$": {
          "type": "object",
          "required": ["name", "description", "price", "category"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 100 },
            "description": { "type": "string", "maxLength": 500 },
            "price": { "type": "integer", "minimum": 0 },
            "currency_type": { "type": "string", "default": "points", "enum": ["points"] },
            "category": { "type": "string", "enum": ["materials", "keys", "roles", "consumables", "cosmetics", "vault", "other"] },
            "role_id": { "type": ["string", "null"], "pattern": "^\\d{17,20}$" },
            "consumable": { "type": "boolean", "default": false },
            "max_per_user": { "type": ["integer", "null"], "minimum": 1 },
            "cooldown_seconds": { "type": "integer", "minimum": 0, "default": 0 },
            "is_active": { "type": "boolean", "default": true },
            "sort_order": { "type": "integer", "default": 0 },
            "metadata": {
              "type": "object",
              "additionalProperties": true,
              "default": {}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["items"],
  "additionalProperties": false
}