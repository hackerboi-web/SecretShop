# Secret Shop - Root Environment Configuration
# Copy this to .env and fill in your values

# Discord Bot
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_CLIENT_SECRET=your_application_client_secret
DISCORD_GUILD_ID=your_server_guild_id

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Bot API
BOT_API_PORT=3001
BOT_API_HOST=0.0.0.0

# JWT Keys (generate with: openssl genrsa -out bot/keys/private.pem 2048 && openssl rsa -in bot/keys/private.pem -pubout -out bot/keys/public.pem)
JWT_PRIVATE_KEY_PATH=./bot/keys/private.pem
JWT_PUBLIC_KEY_PATH=./bot/keys/public.pem
JWT_ISSUER=secret-shop-bot
JWT_AUDIENCE=secret-shop-dashboard

# Shared Secret (generate a random 64-char string)
DASHBOARD_SHARED_SECRET=your_64_char_shared_secret_here

# Dashboard
DASHBOARD_URL=http://localhost:5000
FLASK_SECRET_KEY=your_32_char_flask_secret_here
DASHBOARD_PORT=5000
DASHBOARD_HOST=0.0.0.0

# OAuth2
OAUTH2_REDIRECT_URI=http://localhost:5000/auth/callback

# Bot Config
PANEL_CHANNEL_ID=your_panel_channel_id
ADMIN_ROLE_IDS=role_id_1,role_id_2